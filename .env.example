# Пример переменных окружения для боевого сервера.
# Скопировать в .env (или задать в окружении systemd/докера) и заполнить
# реальными значениями. Файл .env в репозиторий НЕ коммитить.

# Django ------------------------------------------------------------------

# Секретный ключ. Сгенерировать новый, например:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Боевой режим: 0 — продакшен (обязательно на сервере), 1 — разработка.
DEBUG=0

# Домены/адреса, с которых принимаются запросы (через запятую, без пробелов).
ALLOWED_HOSTS=example.com,www.example.com

# Доверенные источники для CSRF (со схемой https, через запятую).
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Принудительный редирект HTTP -> HTTPS. Включить (1) только после настройки
# HTTPS, иначе на старте по IP возможна редирект-петля.
SECURE_SSL_REDIRECT=0

# Secure-куки (Session/CSRF). По умолчанию 0 — работа по HTTP. Включить (1)
# только вместе с HTTPS: иначе браузер не шлёт CSRF-cookie и формы дают 403.
COOKIE_SECURE=0

# База данных -------------------------------------------------------------

# Если задано — используется PostgreSQL; если пусто/не задано — SQLite.
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://wordcards:password@localhost:5432/wordcards
